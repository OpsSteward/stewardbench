# Replace all example values before deployment. Do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
STEWARD_BENCH_APPLICATION_VERSION=1.0.0

POSTGRES_DB=stewardbench
POSTGRES_USER=stewardbench
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional host port for the web service.
STEWARD_WEB_PORT=8000
